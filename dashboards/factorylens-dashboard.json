  "widgets": [
    {
      "id": "panel-duration",
      "title": "Pipeline stage duration (avg, per stage)",
      "description": "Average duration of each pipeline stage over time. Toggle 'Stacked' in the panel to read total pipeline time. Stages: ingest, clean, transform, aggregate.",
      "panelTypes": "graph",
      "isStacked": true,
      "opacity": "1",
      "nullZeroValues": "zero",
      "timePreferance": "GLOBAL_TIME",
      "softMin": 0,
      "softMax": 0,
      "yAxisUnit": "ns",
      "query": {
        "queryType": "builder",
        "promql": [],
        "clickhouse_sql": [],
        "builder": {
          "queryData": [
            {
              "dataSource": "traces",
              "queryName": "A",
              "aggregateOperator": "avg",
              "aggregateAttribute": {
                "key": "durationNano",
                "dataType": "float64",
                "type": "",
                "isColumn": true,
                "id": "durationNano--float64----true"
              },
              "timeAggregation": "avg",
              "spaceAggregation": "avg",
              "functions": [],
              "filters": {
                "op": "AND",
                "items": [
                  {
                    "id": "f-svc-dur",
                    "key": {
                      "key": "serviceName",
                      "dataType": "string",
                      "type": "",
                      "isColumn": true,
                      "id": "serviceName--string----true"
                    },
                    "op": "=",
                    "value": "factorylens"
                  },
                  {
                    "id": "f-name-dur",
                    "key": {
                      "key": "name",
                      "dataType": "string",
                      "type": "",
                      "isColumn": true,
                      "id": "name--string----true"
                    },
                    "op": "in",
                    "value": [
                      "ingest",
                      "clean",
                      "transform",
                      "aggregate"
                    ]
                  }
                ]
              },
              "expression": "A",
              "disabled": false,
              "stepInterval": 60,
              "having": [],
              "limit": null,
              "orderBy": [],
              "groupBy": [
                {
                  "key": "name",
                  "dataType": "string",
                  "type": "",
                  "isColumn": true,
                  "id": "name--string----true"
                }
              ],
              "legend": "{{name}}",
              "reduceTo": "avg"
            }
          ],
          "queryFormulas": []
        }
      }
    },
