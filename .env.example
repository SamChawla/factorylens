# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- SigNoz Cloud (OTLP/HTTP export) ---
# Region-specific ingest endpoint, e.g. https://ingest.<region>.signoz.cloud:443
SIGNOZ_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443
# Ingestion key from SigNoz Cloud -> Settings -> Ingestion Settings
SIGNOZ_INGESTION_KEY=your-ingestion-key-here

# Logical service name shown in SigNoz
OTEL_SERVICE_NAME=factorylens

# Set to false to skip real export (spans print to console instead) — useful before OAuth/keys are set up
TELEMETRY_ENABLED=true

# --- SigNoz Cloud management API (used by `factorylens dashboard`) ---
# A DIFFERENT credential from the ingestion key above: that one is write-only
# for telemetry and cannot create dashboards.
# App URL = the host in your browser address bar (note: not the "ingest." host)
SIGNOZ_APP_URL=https://your-tenant.us.signoz.cloud
# Settings -> API Keys -> create one with write access
SIGNOZ_API_KEY=your-signoz-api-key-here

# --- LLM providers (Q&A CLI) ---
# Primary: Euri (OpenAI-compatible)
EURI_API_KEY=your-euri-key-here
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_MODEL=openai/gpt-4.1-mini

# Fallback: Groq (groq.com) — note: Groq, not Grok (x.ai).
# Model IDs here are bare (no "openai/" prefix), unlike Euri's.
GROQ_API_KEY=your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
