# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- SigNoz / OTLP export ---
# Works against SigNoz Cloud OR a self-hosted instance. Pick ONE block below.
#
# (A) SigNoz Cloud: region ingest endpoint + ingestion key.
SIGNOZ_OTLP_ENDPOINT=https://ingest.us.signoz.cloud:443
# Ingestion key from SigNoz Cloud -> Settings -> Ingestion Settings
SIGNOZ_INGESTION_KEY=your-ingestion-key-here
SIGNOZ_SELF_HOSTED=false
#
# (B) Self-hosted SigNoz (Foundry / Docker Compose — see docs/self-hosted.md):
#     the local collector needs no ingestion key. Comment out (A) and use:
# SIGNOZ_OTLP_ENDPOINT=http://localhost:4318
# SIGNOZ_INGESTION_KEY=
# SIGNOZ_SELF_HOSTED=true

# Logical service name shown in SigNoz
OTEL_SERVICE_NAME=factorylens

# Set to false to skip real export (spans print to console instead) — useful before keys/stack are set up
TELEMETRY_ENABLED=true

# The dashboard is imported by hand (Dashboards -> Import JSON) or pushed via the
# management API; no management credential is required to run FactoryLens.

# --- LLM providers (Q&A CLI) ---
# Primary: Euri (OpenAI-compatible)
EURI_API_KEY=your-euri-key-here
EURI_BASE_URL=https://api.euron.one/api/v1/euri
EURI_MODEL=openai/gpt-4.1-mini

# Fallback: Groq (groq.com) — note: Groq, not Grok (x.ai).
# Model IDs here are bare (no "openai/" prefix), unlike Euri's.
GROQ_API_KEY=your-groq-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
